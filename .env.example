NODE_ENV=development
PORT=3000
# Local development only. Use authenticated Atlas/replica-set credentials in production.
MONGODB_URL=mongodb://127.0.0.1:27017/shop?replicaSet=rs0&directConnection=true&maxPoolSize=10&serverSelectionTimeoutMS=5000
# Replace all three values using npm run keys. Do not commit real credentials.
API_READ_KEY=
API_WRITE_KEY=
API_ADMIN_KEY=
CURRENCY=USD
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_MAX=120
GRAFANA_ADMIN_PASSWORD=
