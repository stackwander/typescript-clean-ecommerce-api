{
  "name": "backendcleants",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/bin/www.ts",
    "generate": "prisma generate",
    "db:push": "tsx scripts/setup-db.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/bin/www.js",
    "lint": "eslint src test scripts",
    "test": "tsx --test test/unit/*.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 test/integration/*.test.ts",
    "keys": "node scripts/generate-keys.mjs",
    "docs:generate": "tsx scripts/openapi.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run build && npm test"
  },
  "prisma": {
    "schema": "src/ca_infrastructure/database/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "prom-client": "^15.1.3",
    "winston": "^3.17.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "prisma": "6.19.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  },
  "overrides": {
    "@prisma/config": {
      "effect": "^3.20.0",
      "deepmerge-ts": "^8.0.0"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    },
    "brace-expansion@^1.1.7": "^1.1.21",
    "flatted": "^3.4.2"
  }
}
